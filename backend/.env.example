APP_ENV=development
SERVICE_NAME=turniping-backend
LOG_LEVEL=INFO
LOG_FORMAT=plain

APP_API_TOKEN=dev-local-token
SESSION_SECRET=dev-local-session-secret
ALLOWED_ORIGINS=http://localhost:3002
RATE_LIMIT_PER_MINUTE=120

DATABASE_URL=postgresql+asyncpg://turniping:turniping@localhost:5432/turniping
REDIS_URL=redis://localhost:6379/0

PRICE_POLL_INTERVAL_SECONDS=30
NEWS_INGEST_INTERVAL_MINUTES=5
PREDICTION_INTERVAL_MINUTES=10
OUTCOME_EVAL_INTERVAL_MINUTES=15
PREDICTION_HORIZON_MINUTES=60

CANDLE_RETENTION_DAYS=90
NEWS_RETENTION_DAYS=30

# DEFAULT_WATCHLIST: 未指定なら app/instruments_catalog.py の全銘柄(現在79銘柄)が既定値になる。
# 一部銘柄だけで始めたい場合のみ、カンマ区切りのコードで上書きする。
# DEFAULT_WATCHLIST=^N225,1306.T,7203.T,6758.T,9984.T

PAPER_STARTING_CASH_JPY=1000000

# AI自動売買シミュレーション(手動ペーパートレードとは別口座)
AI_TRADER_STARTING_CASH_JPY=50000
AUTO_TRADER_INTERVAL_MINUTES=10
AUTO_TRADER_MAX_POSITION_JPY=10000
AUTO_TRADER_BUY_CONFIDENCE_THRESHOLD=35
AUTO_TRADER_SELL_CONFIDENCE_THRESHOLD=35

# ニュースセンチメントの参照期間(時間)。個別銘柄名でのGoogle News検索はヒットが少なく
# 24時間だと母数不足になりがちなため、48時間まで見る(実測に基づく)。
SENTIMENT_LOOKBACK_HOURS=48

# 自己学習: 答え合わせ実績から各シグナルの重みを再計算する頻度(分)
STRATEGY_LEARNING_INTERVAL_MINUTES=60
