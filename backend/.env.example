APP_ENV=development
SERVICE_NAME=turniping-backend
LOG_LEVEL=INFO
LOG_FORMAT=plain

APP_API_TOKEN=dev-local-token
SESSION_SECRET=dev-local-session-secret
ALLOWED_ORIGINS=http://localhost:3002
RATE_LIMIT_PER_MINUTE=120

DATABASE_URL=postgresql+asyncpg://turniping:turniping@localhost:5432/turniping
REDIS_URL=redis://localhost:6379/0

PRICE_POLL_INTERVAL_SECONDS=30
NEWS_INGEST_INTERVAL_MINUTES=5
PREDICTION_INTERVAL_MINUTES=10
OUTCOME_EVAL_INTERVAL_MINUTES=15
PREDICTION_HORIZON_MINUTES=60

CANDLE_RETENTION_DAYS=90
NEWS_RETENTION_DAYS=30

DEFAULT_WATCHLIST=^N225,1306.T,7203.T,7267.T,7201.T,6758.T,6501.T,6702.T,6861.T,9984.T,9432.T,9433.T,6098.T,8306.T,8316.T,8411.T,8604.T,8058.T,8031.T,8001.T,9983.T,3382.T,4502.T,4503.T,5401.T,7974.T

